# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eoffice?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Seed demo admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@eoffice.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# File storage — local disk path for uploaded documents/media (created automatically)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25
